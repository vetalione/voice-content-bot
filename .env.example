# Template only; .env and all credentials remain ignored by Git.
BOT_TOKEN=
ALLOWED_CHANNEL_ID=0
OWNER_TELEGRAM_ID=0
ALLOWED_USER_IDS=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
WEBHOOK_PATH=/telegram/webhook

TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_SECONDS=600
TRANSCRIPT_LANGUAGE=ru

SEMANTIC_PIPELINE_ENABLED=true
TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# IDs verified in the public catalog 2026-09-07. Rechecked at startup.
OPENROUTER_PRIMARY_MODEL=moonshotai/kimi-k2.5
OPENROUTER_PRIMARY_FALLBACK_MODEL=
OPENROUTER_ESCALATION_MODEL=moonshotai/kimi-k3
# Explicit paid opt-in for the configured Kimi models.
# /settings in Telegram switches new recordings between these paid models and
# free auto/named models. Free choice disables ALL paid fallback/audit routes.
# Choice persists in CHECKPOINT_BACKEND (use Supabase on Render Free).
OPENROUTER_ALLOW_PAID=true
OPENROUTER_ALLOW_ESCALATION=true
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_REQUESTS_PER_RECORDING=60
# Completion limit: omitted by default; the model/provider chooses its limit.
# Optional ONE global ceiling for all OpenRouter calls, including reasoning:
# OPENROUTER_MAX_OUTPUT_TOKENS=32768
QUALITY_AUDITOR=auto
FORCE_QUALITY_AUDIT=false
WRITING_PROVIDER=primary
ESCALATE_IF_DURATION_MINUTES=30
COVERAGE_CONFIDENCE_THRESHOLD=0.7

EXTRACTION_WINDOW_MINUTES=12
EXTRACTION_OVERLAP_MINUTES=2
TARGET_ATOM_LIMIT=10
OVERFLOW_MAX_PASSES=2
SEMANTIC_REASONING_EFFORT=medium
WRITING_REASONING_EFFORT=low
MAX_THREADS_CANDIDATES=4
MAX_REELS_CANDIDATES=4

# Optional personal Claude Agent SDK layer; install requirements-claude.txt first.
CLAUDE_ENABLED=false
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TIMEOUT_SECONDS=300
CLAUDE_MAX_BUDGET_USD=0.5

# SQLite for local use; Render Free must use supabase for restart durability.
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=/tmp/voice-content-bot/checkpoints.sqlite3
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONTHLY_LLM_BUDGET_USD=15
SOFT_BUDGET_WARNING_USD=10
STOP_ON_BUDGET_EXCEEDED=false

LOG_LEVEL=INFO
JOB_CONCURRENCY=1
WORK_DIR=/tmp/voice-content-bot
ENABLE_FULL_TRANSCRIPT=false
DRY_RUN_PUBLISH=false
TEASER_INCLUDE_TIMESTAMPS=true
TEASER_REPLY_TO_SOURCE=true
# Legacy fallback path only: SEMANTIC_PIPELINE_ENABLED=false, TEXT_PROVIDER=groq
# or TEXT_PROVIDER=openrouter and an explicit OPENROUTER_MODEL.

# Legacy compatibility only: accepted but ignored by the OpenRouter text path.
SEMANTIC_MAX_INPUT_TOKENS=90000
SEMANTIC_MAX_OUTPUT_TOKENS=8000
THREADS_BATCH_SIZE=2
REELS_BATCH_SIZE=2
TEXT_TEASER_MAX_TOKENS=1800
TEXT_THREADS_MAX_TOKENS=5000
TEXT_REELS_MAX_TOKENS=6000
