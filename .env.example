# Copy to .env; never put real credentials in this template.
BOT_TOKEN=
ALLOWED_CHANNEL_ID=
OWNER_TELEGRAM_ID=
ALLOWED_USER_IDS=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
WEBHOOK_PATH=/telegram/webhook

# Groq is used for audio transcription only by default.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_TIMEOUT_SECONDS=600
TRANSCRIPT_LANGUAGE=ru

# Text stages: free-only by default. No OpenAI/Anthropic keys are used.
TEXT_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_ALLOW_PAID=false
OPENROUTER_REASONING_EFFORT=none
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_REQUESTS_PER_RECORDING=30

# Extract first, deduplicate globally, select locally, then generate.
MINER_WINDOW_MINUTES=12
MINER_WINDOW_OVERLAP_MINUTES=0.5
MAX_THREADS_CANDIDATES=4
MAX_REELS_CANDIDATES=4
THREADS_BATCH_SIZE=2
REELS_BATCH_SIZE=2
TEXT_MAX_INPUT_TOKENS=12000
TEXT_EXTRACTION_MAX_TOKENS=3000
TEXT_TEASER_MAX_TOKENS=800
TEXT_THREADS_MAX_TOKENS=2000
TEXT_REELS_MAX_TOKENS=3000

LOG_LEVEL=INFO
JOB_CONCURRENCY=1
WORK_DIR=/tmp/voice-content-bot
ENABLE_FULL_TRANSCRIPT=false
DRY_RUN_PUBLISH=false

# Optional future switch: TEXT_PROVIDER=groq uses the retained Groq text client.
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_TPM_LIMIT=8000
